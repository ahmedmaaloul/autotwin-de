# AutoTwin DE — local configuration template.
#
#     cp .env.example .env && make demo
#
# Every value below is a working default for a laptop: the file is runnable as-is, with no
# account, no API key and no credit card (BUILD_SPEC §0.1). Copy it, do not rename it —
# `.env` is git-ignored, `.env.example` is the documented contract.
#
# The Python settings object is `autotwin_core.config.Settings` (BUILD_SPEC §5). It reads
# this file with the prefix `AUTOTWIN_`, so `AUTOTWIN_LOG_LEVEL` fills `Settings.log_level`.
# Nothing in the codebase reads `os.environ` directly.
#
# docker compose also reads this file. Host-facing values (localhost:5433, localhost:19092)
# are correct for the default developer loop, where the API runs on the host with `make api`.
# When a service runs *inside* compose, docker-compose.yml overrides those three URLs with
# their in-network equivalents — `environment:` wins over `env_file:` — so one file serves
# both topologies without a second copy that drifts.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# local | ci | docker — selects timeouts and log defaults, never data behaviour.
AUTOTWIN_ENV=local
# Verbose tracebacks and FastAPI reload hints. Never true in a shared environment.
AUTOTWIN_DEBUG=false
AUTOTWIN_LOG_LEVEL=INFO
# console is readable in a terminal; compose sets json so logs stay machine-parseable.
AUTOTWIN_LOG_FORMAT=console
# Allowed browser origins for the API, JSON list. The Next.js dev server runs on 3000.
AUTOTWIN_CORS_ORIGINS=["http://localhost:3000"]
# Ceiling for every outbound HTTP call to an external source.
AUTOTWIN_HTTP_TIMEOUT_S=20
# Sent on every request to DWD/Autobahn/OSRM/Nominatim — those are community and public-sector
# services, and identifying the client is the price of using them politely.
AUTOTWIN_HTTP_USER_AGENT="AutoTwinDE/0.1 (portfolio project; +github)"

# ---------------------------------------------------------------------------
# Data sourcing strategy
# ---------------------------------------------------------------------------
# live   — always hit the source, fail loudly if it is down
# cached — try live, fall back to data/raw, then to the bundled fixture (the default)
# fixture— never touch the network; what CI and the test suite use
AUTOTWIN_DATA_MODE=cached
# Root of the on-disk data lake: raw downloads, bronze/silver/gold parquet.
AUTOTWIN_DATA_DIR=./data
# How long a cached download stays authoritative before a live refetch is attempted (6 h).
AUTOTWIN_CACHE_TTL_SECONDS=21600

# ---------------------------------------------------------------------------
# Database — PostgreSQL 16 + PostGIS 3.4
# ---------------------------------------------------------------------------
# Port 5433, not 5432: a developer's pre-existing local Postgres keeps 5432 (BUILD_SPEC §5).
# PostGIS container image. The official image is amd64-only; on Apple Silicon it runs
# under emulation. For a native arm64 build use the multi-arch community image:
#   POSTGRES_IMAGE=imresamu/postgis:16-3.5
POSTGRES_IMAGE=postgis/postgis:16-3.4

AUTOTWIN_DATABASE_URL=postgresql+psycopg://autotwin:autotwin@localhost:5433/autotwin
# AUTOTWIN_DATABASE_URL_SYNC is derived from the URL above (psycopg driver, no async layer)
# and is only worth setting when Alembic must reach a different host than the application.
# AUTOTWIN_DATABASE_URL_SYNC=postgresql+psycopg://autotwin:autotwin@localhost:5433/autotwin
# The simulator opens one connection per writer batch; 10 is ample for a laptop and keeps
# the default max_connections=100 of the container far out of reach.
AUTOTWIN_DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Streaming — Redpanda (Kafka API)
# ---------------------------------------------------------------------------
# 19092 is the external listener; in-compose clients use redpanda:9092 instead.
AUTOTWIN_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
# false makes the simulator write straight to Postgres through the same TelemetrySink
# interface (BUILD_SPEC §8). `make demo` stays runnable when the broker will not start.
AUTOTWIN_KAFKA_ENABLED=true
AUTOTWIN_KAFKA_CLIENT_ID=autotwin

# ---------------------------------------------------------------------------
# Data sources — all keyless, all public. See DATA_LICENSES.md before redistributing.
# ---------------------------------------------------------------------------
# Public OSRM demo server. It is community infrastructure with a usage policy: for anything
# beyond a handful of routes run `make osrm-prepare && make osrm-up` and point this at
# http://localhost:5001 (or http://osrm:5000 from inside compose).
AUTOTWIN_OSRM_BASE_URL=https://router.project-osrm.org
AUTOTWIN_OSRM_TIMEOUT_S=20
# Bundesnetzagentur Ladesäulenregister (CC BY 4.0), the charging-infrastructure source.
AUTOTWIN_BNETZA_DOWNLOAD_URL=https://data.bundesnetzagentur.de/Bundesnetzagentur/SharedDocs/Downloads/DE/Sachgebiete/Energie/Unternehmen_Institutionen/E_Mobilitaet/Ladesaeulenregister.csv
# Deutscher Wetterdienst open data (CC BY 4.0) — station observations and MOSMIX.
AUTOTWIN_DWD_BASE_URL=https://opendata.dwd.de
# Autobahn GmbH public traffic API — keyless, licence undeclared (see DATA_LICENSES.md).
AUTOTWIN_AUTOBAHN_BASE_URL=https://verkehr.autobahn.de/o/autobahn
# Nominatim geocoding (ODbL). Rate-limited to 1 req/s by policy; the provider caches to disk.
AUTOTWIN_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ---------------------------------------------------------------------------
# Machine learning
# ---------------------------------------------------------------------------
# Where energy_consumption_v{N}.joblib and its metrics.json live.
AUTOTWIN_ML_MODEL_DIR=./models
# Name of the model the /api/v1/ml endpoints serve; the active version is resolved from
# the ml_models registry table, not from this value.
AUTOTWIN_ML_ACTIVE_MODEL=energy_consumption

# ---------------------------------------------------------------------------
# Simulator
# ---------------------------------------------------------------------------
AUTOTWIN_SIM_DEFAULT_VEHICLES=40
# Wall-clock seconds between physics ticks.
AUTOTWIN_SIM_TICK_SECONDS=1.0
# Simulated seconds per wall-clock second: 10 turns a two-hour corridor into twelve minutes.
AUTOTWIN_SIM_SPEED_FACTOR=10.0
# Fixed seed — a demo has to be reproducible, and so does the ML training set.
AUTOTWIN_SIM_SEED=20260214

# ---------------------------------------------------------------------------
# Optional LLM copilot — off by default, and the platform is complete without it
# ---------------------------------------------------------------------------
# While false, POST /api/v1/copilot/ask answers 503 instead of pretending.
AUTOTWIN_LLM_ENABLED=false
# Local Ollama, so the "zero cost, no account" rule survives the feature.
AUTOTWIN_OLLAMA_BASE_URL=http://localhost:11434
AUTOTWIN_OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Web application (Node, not pydantic — read by apps/web/next.config.ts)
# ---------------------------------------------------------------------------
# Server-side proxy target for /api/backend/*, which keeps the API origin out of the browser
# bundle and sidesteps CORS in development.
AUTOTWIN_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Local infrastructure (docker compose interpolation, not application settings)
# ---------------------------------------------------------------------------
# Airflow's containers run as this uid so files they write into ./orchestration/airflow are
# owned by you on Linux. On macOS and Windows the value is irrelevant — leave it alone.
AIRFLOW_UID=50000
